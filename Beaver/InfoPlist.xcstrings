    "NSCameraUsageDescription": {
      "comment": "iOS: why Beaver asks for the camera",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver uses the camera to scan paper documents into PDFs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver nutzt die Kamera, um Papierdokumente als PDFs zu scannen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver koristi kameru za skeniranje papirnatih dokumenata u PDF-ove."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver koristi kameru za skeniranje papirnatih dokumenata u PDF-ove."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver koristi kameru za skeniranje papirnih dokumenata u PDF-ove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver usa la cámara para escanear documentos en papel y convertirlos en PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Beaver usa a câmera para digitalizar documentos em papel e convertê-los em PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver использует камеру, чтобы сканировать бумажные документы в PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver 使用相机将纸质文稿扫描为 PDF。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver utilise la caméra pour numériser des documents papier en PDF."
          }
        }
      }
