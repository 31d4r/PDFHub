    "Merge PDFs, split them into pages, or turn images into a PDF. Your originals are never changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge PDFs, split them into pages, or turn images into a PDF. Your originals are never changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe PDFs zusammen, teile sie in Seiten oder wandle Bilder in ein PDF um. Deine Originale bleiben unverändert."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoji PDF-ove, podijeli ih na stranice ili pretvori slike u PDF. Originali se nikad ne mijenjaju."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoji PDF-ove, podijeli ih na stranice ili pretvori slike u PDF. Originali se nikad ne mijenjaju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
