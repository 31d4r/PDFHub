    "scan.filter.blackAndWhite.help": {
      "comment": "Scan filter hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only black ink on white paper. Best for text, smallest file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur schwarze Tinte auf weißem Papier. Am besten für Text, kleinste Datei."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo crna tinta na bijelom papiru. Najbolje za tekst, najmanja datoteka."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo crna tinta na bijelom papiru. Najbolje za tekst, najmanja datoteka."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo crna mastila na belom papiru. Najbolje za tekst, najmanja datoteka."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tinta negra sobre papel blanco. Ideal para texto; el archivo más pequeño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só tinta preta em papel branco. Melhor para texto; arquivo menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чёрные чернила на белой бумаге. Лучше всего для текста, самый маленький файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅白纸黑字。最适合文本，文件最小。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement de l’encre noire sur papier blanc. Idéal pour le texte, fichier le plus léger."
          }
        }
      }
    },
