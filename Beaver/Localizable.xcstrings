    "Your original files aren’t changed. You can undo this, including the rotations you made.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original files aren’t changed. You can undo this, including the rotations you made."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originaldateien werden nicht geändert. Du kannst dies rückgängig machen, einschließlich der Drehungen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalne datoteke se ne mijenjaju. Možeš ovo poništiti, uključujući rotacije koje si napravio/la."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalne datoteke se ne mijenjaju. Možeš ovo poništiti, uključujući rotacije koje si napravio/la."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalne datoteke se ne menjaju. Možeš ovo poništiti, uključujući rotacije koje si napravio/la."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos originales no se modifican. Puedes deshacer esto, incluidas las rotaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos originais não são alterados. Você pode desfazer isso, inclusive as rotações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные файлы не изменяются. Можно отменить это, включая повороты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始文件不会被更改。你可以撤销此操作，包括已做的旋转。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes fichiers originaux ne sont pas modifiés. Tu peux annuler, y compris les rotations."
          }
        }
      }
    },
