    "scan.cornersCross": {
      "comment": "iOS: why Done is off in the corner editor",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edges cross. Move the corners so they outline the page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kanten kreuzen sich. Verschiebe die Ecken so, dass sie die Seite umreißen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubovi se sijeku. Pomakni uglove tako da ocrtavaju stranicu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubovi se sijeku. Pomakni kutove tako da ocrtavaju stranicu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ivice se seku. Pomeri uglove tako da ocrtavaju stranicu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bordes se cruzan. Mueve las esquinas para delimitar la página."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As bordas se cruzam. Mova os cantos para contornar a página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Края пересекаются. Передвинь углы, чтобы обвести страницу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边缘交叉了。请移动四角以框出页面。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bords se croisent. Déplace les coins pour délimiter la page."
          }
        }
      }
    },
