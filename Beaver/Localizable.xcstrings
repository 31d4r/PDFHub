    "scan.cameraDenied.message": {
      "comment": "iOS alert message when the camera is off for Beaver",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver needs the camera to scan documents. You can turn it on in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver braucht die Kamera, um Dokumente zu scannen. Du kannst sie in den Einstellungen einschalten."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaveru treba kamera za skeniranje dokumenata. Možeš je uključiti u Postavkama."
          }
