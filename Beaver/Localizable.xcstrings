          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía páginas de papel. Beaver encuentra los bordes y endereza cada página."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
