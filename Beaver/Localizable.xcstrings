    "mobile.empty.message": {
      "comment": "iOS empty state message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan paper or add PDFs and photos, then merge them, split them into pages or turn them into one PDF. Your originals are never changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne Papier oder füge PDFs und Fotos hinzu, führe sie zusammen, teile sie in Seiten oder wandle sie in ein PDF um. Deine Originale bleiben unverändert."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeniraj papir ili dodaj PDF-ove i fotografije, zatim ih spoji, podijeli na stranice ili pretvori u jedan PDF. Originali se nikad ne mijenjaju."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeniraj papir ili dodaj PDF-ove i fotografije, zatim ih spoji, podijeli na stranice ili pretvori u jedan PDF. Originali se nikad ne mijenjaju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeniraj papir ili dodaj PDF-ove i fotografije, zatim ih spoji, podeli na stranice ili pretvori u jedan PDF. Originali se nikad ne menjaju."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea papel o añade PDF y fotos; luego combínalos, sepáralos en páginas o conviértelos en un PDF. Tus originales nunca se modifican."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize papel ou adicione PDFs e fotos; depois mescle, divida em páginas ou transforme em um PDF. Seus originais nunca são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируй бумагу или добавь PDF и фото, затем объедини, раздели на страницы или сделай один PDF. Исходные файлы не изменяются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描纸张或添加 PDF 和照片，然后合并、拆分为页面或转为一个 PDF。原始文件绝不会被更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérise du papier ou ajoute des PDF et photos, puis fusionne, découpe en pages ou transforme en un PDF. Tes originaux ne sont jamais modifiés."
          }
        }
      }
    },
