          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina PDF, sepáralos en páginas o convierte imágenes en un PDF. Tus originales nunca se modifican."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mescle PDFs, divida-os em páginas ou transforme imagens em um PDF. Seus originais nunca são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяй PDF, разделяй на страницы или превращай изображения в PDF. Исходные файлы не изменяются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并 PDF、拆分为页面，或将图片转为 PDF。原始文件绝不会被更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
