          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver necesita la cámara para escanear documentos. Puedes activarla en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Beaver precisa da câmera para digitalizar documentos. Você pode ativá-la em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver нуждается в камере для сканирования. Включи её в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver 需要使用相机来扫描文稿。你可以在“设置”中打开。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaver a besoin de la caméra pour numériser. Tu peux l’activer dans Réglages."
          }
        }
      }
    },
