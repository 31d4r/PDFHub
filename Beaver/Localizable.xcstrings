    "scan.filter.enhanced.help": {
      "comment": "Scan filter hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes shadows and makes the paper white. Best for most pages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Schatten und macht das Papier weiß. Am besten für die meisten Seiten."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja sjene i čini papir bijelim. Najbolje za većinu stranica."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja sjene i čini papir bijelim. Najbolje za većinu stranica."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja senke i čini papir belim. Najbolje za većinu stranica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita sombras y deja el papel blanco. Ideal para la mayoría de páginas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove sombras e deixa o papel branco. Ideal para a maioria das páginas."
          }
