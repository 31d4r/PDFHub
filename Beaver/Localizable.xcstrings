    "scan.saveFailed": {
      "comment": "iOS alert when the scanned PDF can't be written",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan couldn't be saved. Make sure there's space on this device, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan konnte nicht gesichert werden. Stelle sicher, dass auf diesem Gerät Platz ist, und versuche es erneut."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sken nije mogao biti sačuvan. Provjeri ima li mjesta na uređaju, pa pokušaj ponovo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sken nije mogao biti spremljen. Provjeri ima li mjesta na uređaju, pa pokušaj ponovo."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sken nije mogao biti sačuvan. Proveri ima li mesta na uređaju, pa pokušaj ponovo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el escaneo. Asegúrate de que haya espacio en este dispositivo e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a digitalização. Verifique se há espaço neste dispositivo e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить скан. Убедись, что на устройстве есть место, и попробуй снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存扫描。请确保此设备有足够空间，然后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La numérisation n’a pas pu être enregistrée. Vérifie qu’il reste de l’espace sur cet appareil, puis réessaie."
          }
        }
      }
    },
