    "scan.scanDocument.help": {
      "comment": "iOS: accessibility hint for Scan Document",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph paper pages. Beaver finds the edges and flattens each page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere Papierseiten. Beaver findet die Ränder und richtet jede Seite aus."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiraj papirnate stranice. Beaver pronalazi rubove i ispravlja svaku stranicu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiraj papirnate stranice. Beaver pronalazi rubove i ispravlja svaku stranicu."
